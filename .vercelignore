# Exclude local-only and large files from Vercel uploads
.git
.env
.env.local
data/
*.db
*.db-journal
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
deploy/
k8s/
docs/
tests/
.vercel/
# Use requirements.txt instead of pyproject.toml (whose cybershield[all] extra
# references the local interntrack package, unresolvable on Vercel's build).
pyproject.toml
src/cybershield/pyproject.toml
src/cybershield/requirements.txt
src/cybershield/alembic.ini
src/cybershield/Dockerfile
src/cybershield/docker-compose.yml
