# InternTrack Environment Configuration
# Copy this file to .env and fill in your values

# ============== Database ==============
DATABASE_URL=sqlite+aiosqlite:///./data/interntrack.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/interntrack

# ============== Redis (Optional) ==============
REDIS_URL=redis://localhost:6379/0

# ============== AI Services ==============
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# ============== Telegram Notifications ==============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============== Discord Notifications ==============
DISCORD_WEBHOOK_URL=

# ============== Slack Notifications ==============
SLACK_WEBHOOK_URL=

# ============== Email (SMTP) ==============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=InternTrack <noreply@interntrack.local>

# ============== Scraper Settings ==============
SCRAPE_INTERVAL_MINUTES=30
MAX_CONCURRENT_SCRAPERS=5
REQUEST_TIMEOUT=30

# ============== Application Settings ==============
APP_NAME=InternTrack
APP_VERSION=1.11.0
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret-key
API_KEY_HEADER=X-API-Key

# ============== CORS ==============
# Comma-separated list of allowed origins, e.g. https://app.example.com,https://admin.example.com
# CORS_ORIGINS=*
# Set to false to send credentials with restricted origins
# CORS_ALLOW_ALL=true

# ============== Rate Limiting ==============
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_API_KEY_PER_MINUTE=1000

# ============== Dashboard ==============
DASHBOARD_PORT=8501

# ============== API Server ==============
API_HOST=0.0.0.0
API_PORT=8000
