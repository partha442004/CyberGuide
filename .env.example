# InternTrack Environment Configuration
# Copy this file to .env and fill in your values

# ============== Database ==============
DATABASE_URL=sqlite+aiosqlite:///./data/interntrack.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/interntrack

# ============== Redis (Optional) ==============
REDIS_URL=redis://localhost:6379/0

# ============== AI Services ==============
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# ============== Telegram Notifications ==============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============== Discord Notifications ==============
DISCORD_WEBHOOK_URL=

# ============== Slack Notifications ==============
SLACK_WEBHOOK_URL=

# ============== Email (SMTP) ==============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=InternTrack <noreply@interntrack.local>

# ============== Scraper Settings ==============
SCRAPE_INTERVAL_MINUTES=30
MAX_CONCURRENT_SCRAPERS=5
REQUEST_TIMEOUT=30
USER_AGENT=CyberGuide/1.0 (+https://github.com/partha442004/CyberGuide)

# ============== Application Settings ==============
APP_NAME=InternTrack
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret-key
API_KEY_HEADER=X-API-Key

# ============== Dashboard ==============
DASHBOARD_PORT=8501

# ============== API Server ==============
API_HOST=0.0.0.0
API_PORT=8000
