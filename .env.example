# InternTrack Environment Configuration
# Copy this file to .env and fill in your values

# ============== Database ==============
DATABASE_URL=sqlite+aiosqlite:///./data/interntrack.db
# For PostgreSQL (local / Railway / Neon): use the asyncpg driver
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/interntrack
# Neon serverless Postgres (free, no credit card) — use ssl=require with asyncpg:
#   postgresql+asyncpg://USER:PASSWORD@ep-XXX-pooler.REGION.aws.neon.tech/neondb?ssl=require

# ============== Redis (Optional) ==============
REDIS_URL=redis://localhost:6379/0

# ============== AI Services ==============
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# ============== Telegram Notifications ==============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============== Discord Notifications ==============
DISCORD_WEBHOOK_URL=

# ============== Slack Notifications ==============
SLACK_WEBHOOK_URL=

# ============== Email (SMTP) ==============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=InternTrack <noreply@interntrack.local>

# ============== Scraper Settings ==============
SCRAPE_INTERVAL_MINUTES=30
MAX_CONCURRENT_SCRAPERS=5
REQUEST_TIMEOUT=30

# ============== Application Settings ==============
APP_NAME=InternTrack
APP_VERSION=1.21.0
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret-key
API_KEY_HEADER=X-API-Key

# ============== CORS ==============
# Comma-separated list of allowed origins, e.g. https://app.example.com,https://admin.example.com
# CORS_ORIGINS=*
# Set to false to send credentials with restricted origins
# CORS_ALLOW_ALL=true

# ============== Rate Limiting ==============
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_API_KEY_PER_MINUTE=1000

# ============== Dashboard ==============
DASHBOARD_PORT=8501

# ============== API Server ==============
API_HOST=0.0.0.0
API_PORT=8000

# ============== Resend Email (deliverability, beats SMTP) ==============
# Free tier: 100 emails/day. Set RESEND_API_KEY to auto-prefer Resend
# for the email channel (over SMTP).
RESEND_API_KEY=
RESEND_FROM=InternTrack <noreply@interntrack.local>

# ============== Twilio SMS + WhatsApp ==============
# SMS: account SID + auth token + a purchased phone number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional default recipient for owner-level broadcasts.
TWILIO_DEFAULT_TO=
# WhatsApp: use the sandbox sender (whatsapp:+14155238886) or a
# business number. Recipients must join the sandbox first.
TWILIO_WHATSAPP_NUMBER=

# ============== AI Job Tools ==============
# When set, the AI Tools page (cover letter / interview questions)
# uses Gemini; otherwise a template generator keeps it working.
GEMINI_API_KEY=
